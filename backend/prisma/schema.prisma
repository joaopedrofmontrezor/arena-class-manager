generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") 
  directUrl = env("DIRECT_URL")   
}

enum Role {
  OWNER
  PROFESSOR
}

enum LessonType {
  TURMA
  PERSONAL
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PROFESSOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonsAsProfessor Lesson[] @relation("ProfessorLessons")
  lessonsAsAssistant Lesson[] @relation("AssistantLessons")

  closedPeriods    ClosedPeriod[]   @relation("PeriodsClosedBy")
  paymentsReceived ClosingPayment[] @relation("PaymentsReceived")
  paymentsMarked   ClosingPayment[] @relation("PaymentsMarked")
}

model Lesson {
  id             String     @id @default(uuid())
  date           DateTime   @db.Date
  time           String
  type           LessonType
  professorId    String
  assistantId    String?
  professorValue Decimal    @db.Decimal(10, 2)
  assistantValue Decimal    @db.Decimal(10, 2)
  observation    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  professor User @relation("ProfessorLessons", fields: [professorId], references: [id])
  assistant User? @relation("AssistantLessons", fields: [assistantId], references: [id])

  
  @@index([professorId, date])
  @@index([assistantId, date])
  @@index([date])
}

// Quinzena fechada: enquanto existir uma linha aqui, nenhuma aula cuja data
// caia em [periodStart, periodEnd] pode ser criada, editada ou excluída.
// Para mexer de novo, o Owner precisa reabrir (apagar) o fechamento.
model ClosedPeriod {
  id          String   @id @default(uuid())
  periodStart DateTime @unique @db.Date
  periodEnd   DateTime @db.Date
  label       String
  closedAt    DateTime @default(now())
  closedById  String

  closedBy User             @relation("PeriodsClosedBy", fields: [closedById], references: [id])
  payments ClosingPayment[]
}

// Pagamento de um professor numa quinzena fechada. "amount" é uma fotografia
// do total a receber no momento em que foi marcado como pago.
model ClosingPayment {
  id             String   @id @default(uuid())
  closedPeriodId String
  professorId    String
  amount         Decimal  @db.Decimal(10, 2)
  paidAt         DateTime @default(now())
  paidById       String

  closedPeriod ClosedPeriod @relation(fields: [closedPeriodId], references: [id])
  professor    User         @relation("PaymentsReceived", fields: [professorId], references: [id])
  paidBy       User         @relation("PaymentsMarked", fields: [paidById], references: [id])

  @@unique([closedPeriodId, professorId])
}
