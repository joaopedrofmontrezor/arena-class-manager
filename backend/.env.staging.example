# Modelo de variáveis para um ambiente de STAGING (homologação) do backend.
# Copie para .env na máquina/serviço de staging e preencha os valores reais.
#
# Importante: mesmo em staging, mantenha NODE_ENV=production. O valor
# "production" aqui não significa "isto é produção de verdade" — é o que
# liga os comportamentos seguros da aplicação (CORS restrito a
# FRONTEND_URL, em vez de aberto para qualquer origem; ver validateEnv()
# em src/config/validate-env.ts). Existe uma única allowlist de origem por
# ambiente, então staging e produção precisam de valores de FRONTEND_URL
# diferentes, cada um só liberando o próprio domínio.

# Use um banco Neon (ou outro Postgres gerenciado) SEPARADO do de produção.
# Nunca aponte staging para o banco de produção.
DATABASE_URL="postgresql://usuario:senha@ep-staging-pooler.sa-east-1.aws.neon.tech/arena_futevolei_staging?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-staging.sa-east-1.aws.neon.tech/arena_futevolei_staging?sslmode=require"

# Gere um segredo PRÓPRIO para staging — nunca reutilize o de produção.
JWT_SECRET="troque-por-um-segredo-forte-e-unico-deste-ambiente"

PORT=3000
NODE_ENV=production

# Domínio do frontend de staging (não o de produção).
FRONTEND_URL=https://staging.suaarena.com

LOG_LEVEL=info
